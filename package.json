{
  "name": "pi-mcb",
  "version": "0.2.3",
  "packageManager": "pnpm@11.2.2",
  "description": "Unified compaction + observational memory extension for Pi — compresses conversation context while preserving durable observations and reflections",
  "license": "MIT",
  "author": "Mohamed Elashri",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CONFIG.md",
    "example-config.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "pnpm check && pnpm test && pnpm build",
    "release:check": "pnpm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "pi-agent",
    "pi-mcb",
    "mcb",
    "compact",
    "compaction",
    "observational-memory",
    "recall",
    "ai",
    "agents",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedElashri/pi-mcb.git"
  },
  "homepage": "https://github.com/MohamedElashri/pi-mcb#readme",
  "bugs": {
    "url": "https://github.com/MohamedElashri/pi-mcb/issues"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
